# --- Garmin.ma — variables d'environnement (aucun secret ici) ---

# URL publique du site. Sert de base aux canonicals, sitemaps, métadonnées sociales.
# Production : https://garmin.ma
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Environnement d'exécution : "production" active l'indexation ; toute autre valeur
# (preview, staging, development) sert un robots.txt "Disallow: /" et des balises noindex.
NEXT_PUBLIC_SITE_ENV=development

# PostgreSQL (Drizzle ORM). Exemple local : postgres://garmin:garmin@127.0.0.1:5432/garmin_ma
DATABASE_URL=

# Secret de signature des sessions (32+ octets aléatoires ; `openssl rand -hex 32`).
SESSION_SECRET=

# Compte administrateur créé par `npm run db:seed` s'il n'existe pas encore.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optionnel : fournisseur de tuiles cartographiques pour l'aperçu des traces
# (laisser vide pour désactiver l'affichage cartographique ; l'analyse fonctionne sans).
NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILES_ATTRIBUTION=&copy; les contributeurs OpenStreetMap
