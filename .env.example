# Copier ce fichier en `.env.local` (déjà ignoré par git via `*.local`).
# Ne jamais commiter de valeurs réelles.

# --- Sign In with LinkedIn using OpenID Connect ---------------------------
# Onglet "Auth" sur https://www.linkedin.com/developers/apps
# Le produit "Sign In with LinkedIn using OpenID Connect" doit être demandé et
# approuvé dans l'onglet "Products", sinon le scope `openid` renvoie 401.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Origine publique du site. Sert à construire le redirect_uri et les
# redirections post-login. En HTTPS, les cookies sont émis avec `Secure`.
APP_BASE_URL=http://localhost:3000

# Facultatif : ne surchargez que si le callback est exposé sur un autre chemin.
# Par défaut : ${APP_BASE_URL}/api/auth/linkedin/callback
# Cette valeur doit correspondre AU CARACTÈRE PRÈS à une "Redirect URL"
# déclarée dans le portail LinkedIn (les query params y sont ignorés, les
# fragments `#` sont refusés).
# LINKEDIN_REDIRECT_URI=

# Facultatif : scopes demandés (séparés par des espaces).
# LINKEDIN_SCOPES=openid profile email

# --- Session applicative ---------------------------------------------------
# Clé de signature HMAC du cookie de session. 32 caractères minimum.
# Générer avec :  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Facultatif : durée de vie de la session en secondes (défaut : 604800 = 7 jours).
# SESSION_TTL_SECONDS=604800

# --- Existant --------------------------------------------------------------
GEMINI_API_KEY=
